<Window x:Class="WeighStation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WeighStation.App.ViewModels"
        mc:Ignorable="d" xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="АвтоВесы — Пост №1" Width="1440" Height="900" MinWidth="1100" MinHeight="720"
        Background="#F3F3F3" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CaptureCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CancelCommand}" />
    </Window.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="200" />
        </Grid.RowDefinitions>

        <!-- header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,12">
            <TextBlock Text="Взвешивание" FontSize="24" FontWeight="SemiBold" />
            <TextBlock DockPanel.Dock="Right" Text="{Binding BarrierText}" VerticalAlignment="Center" Style="{StaticResource Caption}" FontSize="13" />
        </DockPanel>

        <!-- status banner -->
        <Border Grid.Row="1" Margin="0,0,0,12" Padding="16,12" CornerRadius="8" Background="#E5F1FB" BorderBrush="#B5D4EE" BorderThickness="1">
            <StackPanel>
                <TextBlock Text="{Binding StateText}" FontWeight="SemiBold" Foreground="#0A3F6B" />
                <TextBlock Text="{Binding ErrorMessage}" Foreground="#9D1C10" Margin="0,4,0,0">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </Border>

        <!-- main row -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.1*" />
                <ColumnDefinition Width="1.4*" />
                <ColumnDefinition Width="1*" />
            </Grid.ColumnDefinitions>

            <!-- weight -->
            <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,16,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top">
                        <Border DockPanel.Dock="Right" CornerRadius="10" Padding="10,2" VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#EEEEEE" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsStable}" Value="True">
                                            <Setter Property="Background" Value="{StaticResource OkBack}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock FontSize="12" FontWeight="SemiBold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="Нестабильно" />
                                        <Setter Property="Foreground" Value="#444444" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsStable}" Value="True">
                                                <Setter Property="Text" Value="✓ Стабильно" />
                                                <Setter Property="Foreground" Value="{StaticResource Ok}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                        <TextBlock Text="Вес на платформе" Style="{StaticResource Caption}" FontSize="13" />
                    </DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,12,0,0">
                        <Ellipse Width="20" Height="20" VerticalAlignment="Center">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Fill" Value="#2E9E4F" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsLightRed}" Value="True">
                                            <Setter Property="Fill" Value="#E5483A" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                        <TextBlock Text="{Binding LightText, StringFormat='Светофор: {0}'}" Margin="10,0,0,0" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="{Binding WeightText}" FontFamily="Consolas" FontSize="84" FontWeight="Bold" />
                            <TextBlock Text="кг" FontSize="24" Foreground="{StaticResource Muted}" VerticalAlignment="Bottom" Margin="10,0,0,14" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>

            <!-- cameras (placeholders until a video source is wired) -->
            <StackPanel Grid.Column="1" Margin="0,0,16,0">
                <Border Style="{StaticResource Card}" Padding="12" Margin="0,0,0,16">
                    <StackPanel>
                        <TextBlock Text="Камера 1 · Въезд, передний номер" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <Border Background="#1D2530" CornerRadius="6" Height="210">
                            <TextBlock Text="Видеопоток камеры 1 (подключается позже)" Foreground="#C9D1D9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}" Padding="12">
                    <StackPanel>
                        <TextBlock Text="Камера 2 · Задний номер прицепа" FontWeight="SemiBold" FontSize="13" Margin="0,0,0,8" />
                        <Border Background="#1D2530" CornerRadius="6" Height="110">
                            <TextBlock Text="Видеопоток камеры 2 (подключается позже)" Foreground="#C9D1D9" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Border>
            </StackPanel>

            <!-- form -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <DockPanel>
                    <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                        <Button Command="{Binding CaptureCommand}" Style="{StaticResource PrimaryButton}" Content="Зафиксировать вес  (F5)" />
                        <UniformGrid Columns="3" Margin="0,8,0,0">
                            <Button Command="{Binding CancelCommand}" Content="Отмена (Esc)" Margin="0,0,4,0" />
                            <Button Command="{Binding OpenBarrierCommand}" Content="Открыть" Margin="4,0" />
                            <Button Command="{Binding CloseBarrierCommand}" Content="Закрыть" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                    <StackPanel>
                        <TextBlock Text="Текущее взвешивание" FontSize="16" FontWeight="SemiBold" />
                        <TextBlock Text="Номер тягача" Style="{StaticResource FieldLabel}" />
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Right" Text="{Binding PlateHint}" Foreground="{StaticResource Ok}" FontWeight="SemiBold" FontSize="12" VerticalAlignment="Center" Margin="8,0,0,0" />
                            <TextBox Text="{Binding PlateInput, UpdateSourceTrigger=PropertyChanged}" FontFamily="Consolas" FontSize="18" FontWeight="Bold" Height="40" />
                        </DockPanel>
                        <TextBlock Text="Прицеп" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Trailer, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Водитель" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Driver, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Контрагент" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Counterparty, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Text="Груз" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Cargo, UpdateSourceTrigger=PropertyChanged}" />
                        <StackPanel Orientation="Horizontal" Margin="0,14,0,0">
                            <RadioButton Content="Брутто (загружен)" IsChecked="{Binding IsGross}" GroupName="Kind" Margin="0,0,16,0" />
                            <RadioButton Content="Тара (пустой)" GroupName="Kind" />
                        </StackPanel>
                    </StackPanel>
                </DockPanel>
            </Border>
        </Grid>

        <!-- recent weighings -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="Последние взвешивания" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,8" />
                <DataGrid ItemsSource="{Binding Recent}" AutoGenerateColumns="False" IsReadOnly="True"
                          HeadersVisibility="Column" GridLinesVisibility="Horizontal" BorderThickness="0"
                          Background="Transparent" RowBackground="Transparent" CanUserAddRows="False">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="80" />
                        <DataGridTextColumn Header="Номер" Binding="{Binding Plate}" Width="140" />
                        <DataGridTextColumn Header="Контрагент" Binding="{Binding Counterparty}" Width="*" />
                        <DataGridTextColumn Header="Груз" Binding="{Binding Cargo}" Width="*" />
                        <DataGridTextColumn Header="Брутто" Binding="{Binding Gross}" Width="100" />
                        <DataGridTextColumn Header="Тара" Binding="{Binding Tare}" Width="100" />
                        <DataGridTextColumn Header="Нетто" Binding="{Binding Net}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
    </Grid>
</Window>
