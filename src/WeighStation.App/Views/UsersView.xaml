<UserControl x:Class="WeighStation.App.Views.UsersView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:app="clr-namespace:WeighStation.App"
             xmlns:vm="clr-namespace:WeighStation.Presentation.Security;assembly=WeighStation.Presentation"
             mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:UsersViewModel}"
             d:DesignWidth="1300" d:DesignHeight="800">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20,16">
            <TextBlock Text="Пользователи" Style="{StaticResource H1}" Margin="0,0,0,12" />

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.5*" MinWidth="420" />
                    <ColumnDefinition Width="1*" MinWidth="360" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0" Style="{StaticResource Card}" Padding="6" Margin="0,0,16,0">
                    <DataGrid ItemsSource="{Binding Users}" SelectedItem="{Binding SelectedUser, Mode=TwoWay}" MinHeight="260" MaxHeight="360"
                              AutomationProperties.Name="Список пользователей">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Логин" Binding="{Binding Login}" Width="110" />
                            <DataGridTextColumn Header="Имя" Binding="{Binding FullName}" Width="*" />
                            <DataGridTextColumn Header="Роль" Binding="{Binding RoleName}" Width="120" />
                            <DataGridTextColumn Header="Состояние" Binding="{Binding Status}" Width="170" />
                            <DataGridTextColumn Header="Последний вход" Binding="{Binding LastLogin}" Width="130" />
                        </DataGrid.Columns>
                    </DataGrid>
                </Border>

                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Text="Учётная запись" Style="{StaticResource H2}" />

                        <TextBlock Text="Логин" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding Login, UpdateSourceTrigger=PropertyChanged}" IsEnabled="{Binding IsNew}" AutomationProperties.Name="Логин" />
                        <TextBlock Text="Имя (попадает в историю взвешиваний)" Style="{StaticResource FieldLabel}" />
                        <TextBox Text="{Binding FullName, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Имя" />

                        <TextBlock Text="Роль" Style="{StaticResource FieldLabel}" />
                        <ComboBox ItemsSource="{Binding RoleOptions}" SelectedItem="{Binding SelectedRole}" DisplayMemberPath="Name" AutomationProperties.Name="Роль" />
                        <TextBlock Text="{Binding SelectedRole.Description}" Style="{StaticResource Caption}" Margin="0,4,0,0" />

                        <CheckBox Content="Учётная запись активна" IsChecked="{Binding IsActive}" IsEnabled="{Binding IsExisting}" Margin="0,12,0,0" />

                        <TextBlock Text="Временный пароль (новому пользователю или для сброса)" Style="{StaticResource FieldLabel}" />
                        <PasswordBox app:PasswordBoxAssist.Password="{Binding Password, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"
                                     AutomationProperties.Name="Временный пароль" />
                        <TextBlock Text="Пользователь сам сменит его при первом входе." Style="{StaticResource Caption}" Margin="0,4,0,0" />

                        <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />
                        <TextBlock Text="{Binding InfoMessage}" Style="{StaticResource InfoText}" />

                        <UniformGrid Columns="2" Margin="0,12,0,0">
                            <Button Command="{Binding SaveCommand}" Content="Сохранить" Style="{StaticResource PrimaryButton}" Height="36" Margin="0,0,4,0" />
                            <Button Command="{Binding NewCommand}" Content="Новый" Margin="4,0,0,0" />
                        </UniformGrid>
                        <UniformGrid Columns="2" Margin="0,8,0,0">
                            <Button Command="{Binding ResetPasswordCommand}" Content="Сбросить пароль" Margin="0,0,4,0" />
                            <Button Command="{Binding UnlockCommand}" Content="Разблокировать" Margin="4,0,0,0" />
                        </UniformGrid>
                    </StackPanel>
                </Border>
            </Grid>

            <Border Style="{StaticResource Card}" Margin="0,16,0,0" Padding="14">
                <StackPanel>
                    <TextBlock Text="Журнал безопасности" Style="{StaticResource H2}" FontSize="15" Margin="0,0,0,8" />
                    <DataGrid ItemsSource="{Binding SecurityLog}" MaxHeight="300" AutomationProperties.Name="Журнал безопасности">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Время" Binding="{Binding Time}" Width="130" />
                            <DataGridTextColumn Header="Пользователь" Binding="{Binding User}" Width="140" />
                            <DataGridTextColumn Header="Событие" Binding="{Binding Action}" Width="220" />
                            <DataGridTextColumn Header="Подробности" Binding="{Binding Details}" Width="*" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
