<Application x:Class="WeighStation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:pages="clr-namespace:WeighStation.Presentation.Pages;assembly=WeighStation.Presentation"
             xmlns:views="clr-namespace:WeighStation.App.Views">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Colors.xaml" />
                <ResourceDictionary Source="Themes/Controls.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- A page view-model on screen is drawn by the matching view. This is the only place that knows the pairs. -->
            <DataTemplate DataType="{x:Type pages:WeighingViewModel}"><views:WeighingView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:JournalViewModel}"><views:JournalView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:ReferencesViewModel}"><views:ReferencesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:ReportsViewModel}"><views:ReportsView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:DevicesViewModel}"><views:DevicesView /></DataTemplate>
            <DataTemplate DataType="{x:Type pages:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        </ResourceDictionary>
    </Application.Resources>
</Application>
