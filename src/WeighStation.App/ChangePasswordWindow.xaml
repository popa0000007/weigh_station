<Window x:Class="WeighStation.App.ChangePasswordWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:app="clr-namespace:WeighStation.App"
        xmlns:vm="clr-namespace:WeighStation.Presentation.Security;assembly=WeighStation.Presentation"
        mc:Ignorable="d" d:DataContext="{d:DesignInstance Type=vm:PasswordChangeViewModel}"
        Title="Смена пароля" Width="420" SizeToContent="Height" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{StaticResource Window}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="14">
    <Border Style="{StaticResource Card}" Margin="16" Padding="22">
        <StackPanel>
            <TextBlock Text="Смена пароля" Style="{StaticResource H2}" />
            <TextBlock Text="{Binding UserName}" Style="{StaticResource Caption}" Margin="0,2,0,0" />

            <TextBlock Text="Текущий пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox app:PasswordBoxAssist.Password="{Binding OldPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Текущий пароль" />
            <TextBlock Text="Новый пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox app:PasswordBoxAssist.Password="{Binding NewPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Новый пароль" />
            <TextBlock Text="Повторите новый пароль" Style="{StaticResource FieldLabel}" />
            <PasswordBox app:PasswordBoxAssist.Password="{Binding ConfirmPassword, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" Height="34" VerticalContentAlignment="Center"
                         AutomationProperties.Name="Повторите новый пароль" />
            <TextBlock Text="Не короче 8 символов, без логина внутри." Style="{StaticResource Caption}" Margin="0,4,0,0" />

            <TextBlock Text="{Binding ErrorMessage}" Style="{StaticResource ErrorText}" />

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Command="{Binding ChangeCommand}" Content="Сменить пароль" Style="{StaticResource PrimaryButton}" IsDefault="True" Padding="20,0" />
                <Button Content="Отмена" Margin="8,0,0,0" IsCancel="True" />
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
