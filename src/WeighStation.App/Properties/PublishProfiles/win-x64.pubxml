<?xml version="1.0" encoding="utf-8"?>
<!-- dotnet publish src/WeighStation.App -p:PublishProfile=win-x64 : one self-contained WeighStation.exe, no .NET needed on the target PC. -->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <!-- SQLite's native library has to be unpacked at start-up; without this it can't be embedded. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <!-- Trimming breaks WPF bindings (they find properties by name at run time), so it stays off. -->
    <PublishTrimmed>false</PublishTrimmed>
    <DebugType>none</DebugType>
    <PublishDir>bin\publish\win-x64\</PublishDir>
  </PropertyGroup>
</Project>
